                                            <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Border Background="#450A0A" CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                                                <TextBlock Text="Not Recommended" FontSize="10" FontWeight="Bold" Foreground="#EF4444"/>
                                            </Border>
                                            <TextBlock Text="System components / protected" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Privacy & Search -->
                    <TabItem FontWeight="SemiBold">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconShieldLock}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
