                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="18" Opacity="0.5" ShadowDepth="4"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Button x:Name="BtnActionLoadProfile" Style="{StaticResource DropdownActionBtn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconFolder}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Load JSON Profile" FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnActionSaveProfile" Style="{StaticResource DropdownActionBtn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconFileText}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Save JSON Profile" FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnActionRecoveryRollback" Style="{StaticResource DropdownActionBtn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconShieldLock}" Fill="#10B981" Width="12" Height="12" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Recovery &amp; Rollback" FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnActionReinstallApps" Style="{StaticResource DropdownActionBtn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconAppGrid}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Reinstall Built-in Apps" FontSize="12" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Border Height="1" Background="#232D42" Margin="4,4"/>
                                            <Button x:Name="BtnActionWikiDocs" Style="{StaticResource DropdownActionBtn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconLayersFeatures}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Documentation" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnActionReportIssue" Style="{StaticResource DropdownActionBtn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconAlertTriangle}" Fill="#F59E0B" Width="12" Height="12" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Report an Issue" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnActionOpenLogs" Style="{StaticResource DropdownActionBtn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconRefresh}" Fill="#94A3B8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Open Session Logs" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BtnActionAbout" Style="{StaticResource DropdownActionBtn}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource IconCheckCircle}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="About NH Win Debloater" FontSize="12" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- 4. Close (✕) -->
                            <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseBtn}" ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Path Data="{StaticResource IconClose}" Fill="#94A3B8" Width="10" Height="10" Stretch="Uniform"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Modern Cyan/Indigo Accent Shimmer Line with Continuous Sweep -->
                <Border Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush x:Name="ShimmerGradient" StartPoint="-1,0" EndPoint="0,0">
                            <GradientStop Color="#000EA5E9" Offset="0.0"/>
                            <GradientStop Color="#FF0EA5E9" Offset="0.25"/>
                            <GradientStop Color="#FF38BDF8" Offset="0.5"/>
                            <GradientStop Color="#FF6366F1" Offset="0.75"/>
                            <GradientStop Color="#006366F1" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <PointAnimation Storyboard.TargetProperty="Background.StartPoint" From="-1,0" To="1,0" Duration="0:0:3.5"/>
                                    <PointAnimation Storyboard.TargetProperty="Background.EndPoint" From="0,0" To="2,0" Duration="0:0:3.5"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Material Stepper Pill Bar across Stages 1-5 -->
        <Border Grid.Row="1" Background="#0B0F17" BorderBrush="#232D42" BorderThickness="0,0,0,1" Padding="24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Pill 1 -->
                <Border x:Name="PillStage1" CornerRadius="15" Background="#1A2234" BorderBrush="#0EA5E9" BorderThickness="1" Padding="12,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BadgeStep1" Width="18" Height="18" CornerRadius="9" Background="#0EA5E9" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtStepNum1" Text="1" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Path x:Name="CheckStep1" Data="{StaticResource IconCheckCircle}" Fill="#10B981" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StepTag1" Text="1. Presets &amp; Scope" FontWeight="Bold" Foreground="#0EA5E9" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="›" Foreground="#475569" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>

                <!-- Pill 2 -->
                <Border x:Name="PillStage2" CornerRadius="15" Background="#131926" BorderBrush="#232D42" BorderThickness="1" Padding="12,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BadgeStep2" Width="18" Height="18" CornerRadius="9" Background="#222C42" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtStepNum2" Text="2" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Path x:Name="CheckStep2" Data="{StaticResource IconCheckCircle}" Fill="#10B981" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StepTag2" Text="2. Select Bloat &amp; Tweaks" FontWeight="Normal" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="›" Foreground="#475569" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>

                <!-- Pill 3 -->
                <Border x:Name="PillStage3" CornerRadius="15" Background="#131926" BorderBrush="#232D42" BorderThickness="1" Padding="12,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BadgeStep3" Width="18" Height="18" CornerRadius="9" Background="#222C42" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtStepNum3" Text="3" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Path x:Name="CheckStep3" Data="{StaticResource IconCheckCircle}" Fill="#10B981" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StepTag3" Text="3. Safety &amp; Dry-Run" FontWeight="Normal" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="›" Foreground="#475569" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>

                <!-- Pill 4 -->
                <Border x:Name="PillStage4" CornerRadius="15" Background="#131926" BorderBrush="#232D42" BorderThickness="1" Padding="12,4" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BadgeStep4" Width="18" Height="18" CornerRadius="9" Background="#222C42" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtStepNum4" Text="4" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Path x:Name="CheckStep4" Data="{StaticResource IconCheckCircle}" Fill="#10B981" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StepTag4" Text="4. Execution" FontWeight="Normal" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="›" Foreground="#475569" FontSize="14" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>

                <!-- Pill 5 -->
                <Border x:Name="PillStage5" CornerRadius="15" Background="#131926" BorderBrush="#232D42" BorderThickness="1" Padding="12,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="BadgeStep5" Width="18" Height="18" CornerRadius="9" Background="#222C42" Margin="0,0,8,0">
                            <TextBlock x:Name="TxtStepNum5" Text="5" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Path x:Name="CheckStep5" Data="{StaticResource IconCheckCircle}" Fill="#10B981" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StepTag5" Text="5. Summary" FontWeight="Normal" Foreground="#64748B" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 3. Dynamic Wizard Views -->
        <Grid Grid.Row="2" Margin="24,18">

            <!-- STAGE 1: Presets & Mode Selection -->
            <Grid x:Name="ViewStage1" Visibility="Visible">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="0" Y="0"/>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Centered Welcome Screen with 4-Color Windows Emblem -->
                <Grid Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="800">
                    <StackPanel HorizontalAlignment="Center">
                        <!-- Custom Vector 4-Pane Multi-Color Windows Emblem -->
                        <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- Top-Left: Coral Red -->
                            <Border Grid.Row="0" Grid.Column="0" Background="#EF4444" CornerRadius="8,2,2,2" Margin="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#EF4444" BlurRadius="10" Opacity="0.35" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>
                            <!-- Top-Right: Emerald Green -->
                            <Border Grid.Row="0" Grid.Column="1" Background="#10B981" CornerRadius="2,8,2,2" Margin="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="10" Opacity="0.35" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>
                            <!-- Bottom-Left: Azure Blue -->
                            <Border Grid.Row="1" Grid.Column="0" Background="#0EA5E9" CornerRadius="2,2,2,8" Margin="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#0EA5E9" BlurRadius="10" Opacity="0.35" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>
                            <!-- Bottom-Right: Amber Gold -->
                            <Border Grid.Row="1" Grid.Column="1" Background="#F59E0B" CornerRadius="2,2,8,2" Margin="2">
                                <Border.Effect>
                                    <DropShadowEffect Color="#F59E0B" BlurRadius="10" Opacity="0.35" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>
                            <!-- Center Accent Sparkle -->
                            <Border Grid.RowSpan="2" Grid.ColumnSpan="2" Width="14" Height="14" CornerRadius="7" Background="#0B0F17" BorderBrush="#38BDF8" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Welcome Heading & Subtitle -->
                        <TextBlock x:Name="TxtWelcomeHeading" Text="Welcome to NH Win Debloater" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtWelcomeSubtitle" Text="Streamline Windows, reclaim memory, and keep full control in a few clicks." FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,24"/>

                        <!-- Target User Scope Bar -->
                        <Border Background="#131926" CornerRadius="20" BorderBrush="#232D42" BorderThickness="1" Padding="16,8" HorizontalAlignment="Center" Margin="0,0,0,26">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Target Scope:" FontWeight="Bold" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                <RadioButton x:Name="RadioScopeAllUsers" Content="All Users (Recommended)" IsChecked="True" GroupName="ScopeGroup" Foreground="#F8FAFC" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <RadioButton x:Name="RadioScopeCurrentUser" Content="Current User Only" GroupName="ScopeGroup" Foreground="#CBD5E1" FontSize="12" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <RadioButton x:Name="RadioScopeDefaultUser" Content="Default User / Sysprep" GroupName="ScopeGroup" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Two Primary Action Buttons Side-by-Side -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <!-- 1. Recommended Setup -->
                            <Button x:Name="BtnRecommendedSetup" Style="{StaticResource PrimaryBtn}" Height="64" MinWidth="270" Margin="0,0,16,0" Background="#0EA5E9" Padding="20,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconLightning}" Fill="#FFFFFF" Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtRecSetupTitle" Text="Recommended Setup" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtRecSetupDesc" Text="Curated safe optimizations &amp; RAM boost" FontSize="11" Foreground="#E0F2FE" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 2. Custom Tuning -->
                            <Button x:Name="BtnCustomTuning" Style="{StaticResource ModernBtn}" Height="64" MinWidth="270" Background="#1A2234" BorderBrush="#0EA5E9" BorderThickness="1.5" Padding="20,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
