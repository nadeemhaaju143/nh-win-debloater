<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NH Win Debloater - Guided Setup Assistant"
    Height="750" Width="1060"
    MinHeight="670" MinWidth="960"
    WindowStartupLocation="CenterScreen"
    Background="#0A0E17" Foreground="#F8FAFC"
    FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Window.Resources>
        <!-- Material Dark Palette & Surface Elevations -->
        <SolidColorBrush x:Key="BgDark" Color="#0A0E17"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#131D31"/>
        <SolidColorBrush x:Key="SurfaceElevated" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2A384F"/>
        <SolidColorBrush x:Key="CardBorderSubtle" Color="#1E293B"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="AccentCyanGlow" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentEmerald" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentRose" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#64748B"/>

        <!-- Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A384F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="BorderBrush" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38BDF8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>  <!-- Header -->
            <RowDefinition Height="46"/>  <!-- Step Indicator -->
            <RowDefinition Height="*"/>   <!-- Main Dynamic Views -->
            <RowDefinition Height="64"/>  <!-- Footer & Navigation -->
        </Grid.RowDefinitions>

        <!-- 1. Header Bar -->
        <Border Grid.Row="0" Background="#131D31" BorderBrush="#2A384F" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo Area -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="LogoFallbackBox" Width="38" Height="38" CornerRadius="8" Background="#0EA5E9" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="NH" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Image x:Name="ImgLogo" MaxWidth="120" MaxHeight="38" Stretch="Uniform" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,14,0"/>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NH Win Debloater" FontWeight="Bold" FontSize="18" Foreground="#F8FAFC"/>
                            <Border x:Name="BadgeVersion" CornerRadius="4" Background="#0284C7" Margin="10,2,0,2" Padding="6,1">
                                <TextBlock x:Name="TxtVersion" Text="v0.3" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Less Bloat. Better Windows. Built for performance." FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- System Info Badge -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="TxtOsCaption" Text="Windows 11 Pro" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtElevationStatus" Text="Elevated Administrator" FontSize="11" Foreground="#10B981" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Step Indicator Bar -->
        <Border Grid.Row="1" Background="#0A0E17" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StepTag1" Text="1. Presets &amp; Scope" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,0,20,0"/>
                <TextBlock Text="›" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock x:Name="StepTag2" Text="2. Select Bloat &amp; Tweaks" FontWeight="Normal" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock Text="›" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock x:Name="StepTag3" Text="3. Safety &amp; Dry-Run" FontWeight="Normal" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock Text="›" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock x:Name="StepTag4" Text="4. Execution" FontWeight="Normal" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock Text="›" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock x:Name="StepTag5" Text="5. Summary" FontWeight="Normal" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- 3. Dynamic Wizard Views -->
        <Grid Grid.Row="2" Margin="24,18">

            <!-- STAGE 1: Presets & Mode Selection -->
            <Grid x:Name="ViewStage1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Choose Debloat Profile &amp; Target Scope" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Select a curated preset to determine which preinstalled packages and system tweaks to target." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Profile Cards -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Preset 1: Recommended Default -->
                    <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="8" Background="#131D31" BorderBrush="#0EA5E9" BorderThickness="2" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="RadioPresetDefault" IsChecked="True" Grid.Row="0" GroupName="PresetGroup" Content="Recommended Safe" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC"/>
                            <TextBlock Grid.Row="1" Text="84 Safe Apps + Core Privacy" FontSize="12" Foreground="#38BDF8" Margin="0,6,0,12"/>
                            <TextBlock Grid.Row="2" Text="Ideal for most users. Safely removes sponsored bloatware, TikTok, Clipchamp, telemetry diagnostics, lockscreen ads, and disables Copilot while leaving essential system components intact." TextWrapping="Wrap" FontSize="13" Foreground="#CBD5E1"/>
                            <Border Grid.Row="3" Background="#0A0E17" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                                <TextBlock Text="✓ Zero Risk to Windows Store or Core Features" FontSize="11" Foreground="#10B981"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Preset 2: Minimal Sponsored -->
                    <Border Grid.Column="1" Margin="6,0,6,0" CornerRadius="8" Background="#131D31" BorderBrush="#2A384F" BorderThickness="1" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="RadioPresetMinimal" Grid.Row="0" GroupName="PresetGroup" Content="Minimal Sponsored" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC"/>
                            <TextBlock Grid.Row="1" Text="Third-Party Junk Only" FontSize="12" Foreground="#94A3B8" Margin="0,6,0,12"/>
                            <TextBlock Grid.Row="2" Text="Targets purely third-party preinstalled sponsored software like Spotify, TikTok, Netflix, and promotional games. Leaves all built-in Microsoft apps completely untouched." TextWrapping="Wrap" FontSize="13" Foreground="#CBD5E1"/>
                            <Border Grid.Row="3" Background="#0A0E17" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                                <TextBlock Text="✓ Conservative &amp; Non-Intrusive" FontSize="11" Foreground="#94A3B8"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Preset 3: Deep Debloat -->
                    <Border Grid.Column="2" Margin="10,0,0,0" CornerRadius="8" Background="#131D31" BorderBrush="#2A384F" BorderThickness="1" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="RadioPresetDeep" Grid.Row="0" GroupName="PresetGroup" Content="Deep / Advanced" FontWeight="Bold" FontSize="15" Foreground="#F8FAFC"/>
                            <TextBlock Grid.Row="1" Text="Maximum Performance" FontSize="12" Foreground="#EAB308" Margin="0,6,0,12"/>
                            <TextBlock Grid.Row="2" Text="Thorough debloating including optional Microsoft productivity utilities (OneNote, Sticky Notes, Voice Recorder). Fully customizable in the next step." TextWrapping="Wrap" FontSize="13" Foreground="#CBD5E1"/>
                            <Border Grid.Row="3" Background="#0A0E17" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                                <TextBlock Text="⚠ Recommended for power users" FontSize="11" Foreground="#F59E0B"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Target Scope Bar -->
                <Border Grid.Row="2" Background="#131D31" CornerRadius="6" BorderBrush="#2A384F" BorderThickness="1" Padding="14,10" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Target Scope:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#F8FAFC"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RadioScopeAllUsers" Content="All Users (Recommended)" IsChecked="True" GroupName="ScopeGroup" Foreground="#F8FAFC" Margin="0,0,18,0"/>
                            <RadioButton x:Name="RadioScopeCurrentUser" Content="Current User Only" GroupName="ScopeGroup" Foreground="#CBD5E1" Margin="0,0,18,0"/>
                            <RadioButton x:Name="RadioScopeDefaultUser" Content="Default User / Sysprep (Provisioned Only)" GroupName="ScopeGroup" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- STAGE 2: App & Tweak Selection -->
            <Grid x:Name="ViewStage2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Refine Packages &amp; System Tweaks" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Confirm or customize packages to remove and system tweak settings to enforce." FontSize="13" Foreground="#94A3B8"/>
                    </StackPanel>
                    <TextBox x:Name="TxtAppFilter" Grid.Column="1" Width="220" Height="30" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155"/>
                </Grid>

                <TabControl Grid.Row="1" Background="#131D31" BorderBrush="#2A384F" Foreground="#F8FAFC">
                    <!-- Tab 1: Bloatware Apps -->
                    <TabItem Header="Bloatware Applications" FontWeight="SemiBold">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Power-User Toolbar: Presets & Filters -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Quick Preset Category Dropdown -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Category:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbAppPresetCategory" Width="210" Height="28" VerticalContentAlignment="Center" Background="#1E293B" Foreground="#0EA5E9" BorderBrush="#334155">
                                        <ComboBoxItem Content="Recommended Safe Bloat (84 Apps)" IsSelected="True"/>
                                        <ComboBoxItem Content="Minimal Sponsored Only (11 Apps)"/>
                                        <ComboBoxItem Content="Deep Debloat (All 162 Packages)"/>
                                        <ComboBoxItem Content="OEM &amp; Third-Party Only"/>
                                        <ComboBoxItem Content="Xbox &amp; Gaming Packages"/>
                                        <ComboBoxItem Content="News, Weather &amp; Media"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Only Installed Apps Filter -->
                                <CheckBox x:Name="ChkOnlyInstalled" Grid.Column="1" Style="{StaticResource ModernCheckBox}" Content="Only show installed apps" IsChecked="False" Margin="0,0,16,0"/>

                                <!-- Selection Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnSelectAllApps" Style="{StaticResource ModernBtn}" Content="Select All" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button x:Name="BtnDeselectAllApps" Style="{StaticResource ModernBtn}" Content="Deselect All" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button x:Name="BtnInvertSelection" Style="{StaticResource ModernBtn}" Content="Invert" Margin="0,0,0,0" Padding="10,4"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TxtAppsSummary" Grid.Row="1" Text="Showing 84 apps selected for removal" VerticalAlignment="Center" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,8"/>

                            <Border Grid.Row="2" Background="#0A0E17" CornerRadius="6" BorderBrush="#2A384F" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListAppsContainer" Margin="10"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Privacy & Search -->
                    <TabItem Header="Privacy &amp; Search" FontWeight="SemiBold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkTelemetry" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Telemetry &amp; Diagnostic Data Collection (Security/Basic level)" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkCopilot" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Windows Copilot &amp; Recall AI screen analysis" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkBingSearch" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Bing Web Search suggestions in Start Menu" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkAdvertisingId" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Advertising ID tracking across installed apps" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkActivityHistory" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Windows Activity History timeline feed" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkTailoredExp" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Tailored Experiences &amp; personalized diagnostic ads" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 3: UI & Shell -->
                    <TabItem Header="Taskbar &amp; Explorer" FontWeight="SemiBold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkShowExt" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Show Known File Extensions (.exe, .txt, .ps1, etc.)" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkShowHidden" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Show Hidden Files, Folders, and Drives" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="SAFE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkExplorerThisPC" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Launch File Explorer directly to 'This PC' instead of Home" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="SAFE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkClassicContextMenu" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Restore Windows 10 Classic Right-Click Context Menu" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="SAFE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkHideWidgets" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Hide Taskbar Widgets / News icon" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="SAFE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkHideChat" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Hide Taskbar Teams / Chat icon" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="SAFE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkEndTask" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Enable right-click 'End Task' directly on the Taskbar" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkAlignLeft" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Align Windows 11 Taskbar icons to the Left (Classic style)" IsChecked="False"/>
                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="OPTIONAL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkHideOneDriveNav" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Hide OneDrive folder from File Explorer Navigation Pane" IsChecked="False"/>
                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="OPTIONAL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkSearchHighlights" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Taskbar Search Highlights &amp; Doodles" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="SAFE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkStartRecommended" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Hide Start Menu Recommended Section &amp; Recent Items" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="SAFE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkCompactExplorer" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Enable Compact View in File Explorer (Tighter classic item padding)" IsChecked="False"/>
                                    <Border Grid.Column="1" Background="#1E293B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="SAFE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMultitasking" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Snap Assist suggestions &amp; app tabs in Alt+Tab" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="SAFE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 4: Gaming & Performance -->
                    <TabItem Header="Gaming &amp; Performance" FontWeight="SemiBold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkGameDVR" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Xbox Game DVR &amp; Background Video Capture (Reduces micro-stutter &amp; latency)" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkDeliveryOpt" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Delivery Optimization P2P (Stops Windows uploading updates to Internet hosts)" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkEdgeBackground" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Microsoft Edge background mode &amp; Startup Boost (Prevents idle RAM consumption)" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkScheduledTasks" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Telemetry Scheduled Tasks (Consolidator, Compatibility Appraiser, ProgramDataUpdater)" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkTelemetryService" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Connected User Experiences &amp; Telemetry Service (DiagTrack background service)" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#78350F" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="CAUTION" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkHibernation" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Reclaim Disk Space by Disabling Hibernation (Removes multi-GB hiberfil.sys)" IsChecked="False"/>
                                    <Border Grid.Column="1" Background="#78350F" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="CAUTION" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/></Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 5: System Extras -->
                    <TabItem Header="System Extras" FontWeight="SemiBold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkConsumerFeatures" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Windows Consumer Features (Blocks silent preinstall of OEM promo apps)" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkLockScreenAds" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Lock Screen tips, fun facts, and promotional suggestions" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkMousePrecision" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Mouse Acceleration / Enhance Pointer Precision (1:1 Mouse Input)" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkStickyKeys" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Sticky Keys prompt (Pressing Shift 5x)" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="SAFE" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkFastStartup" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Fast Startup (Avoid hibernation boot anomalies)" IsChecked="False"/>
                                    <Border Grid.Column="1" Background="#78350F" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="CAUTION" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkStorageSense" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Storage Sense automatic background deletion" IsChecked="False"/>
                                    <Border Grid.Column="1" Background="#78350F" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="CAUTION" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkPreventAutoReboot" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Prevent automatic reboot while users are logged on for updates" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkExcludeDrivers" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Exclude third-party drivers from Windows Update quality updates" IsChecked="True"/>
                                    <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 6: Optional Features -->
                    <TabItem Header="Optional Features" FontWeight="SemiBold">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                            <StackPanel>
                                <TextBlock Text="Optional Windows Components:" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkWindowsSandbox" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Enable Windows Sandbox (Lightweight disposable virtual desktop)" IsChecked="False"/>
                                    <Border Grid.Column="1" Background="#881337" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="HIGH IMPACT" FontSize="10" FontWeight="Bold" Foreground="#F87171"/></Border>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkWSL" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Enable Windows Subsystem for Linux (WSL)" IsChecked="False"/>
                                    <Border Grid.Column="1" Background="#881337" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="HIGH IMPACT" FontSize="10" FontWeight="Bold" Foreground="#F87171"/></Border>
                                </Grid>
                                <TextBlock Text="Note: Enabling optional Windows features requires system virtualization support (VT-x/AMD-V)." FontSize="11" Foreground="#94A3B8" Margin="0,10,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- STAGE 3: Safety & Dry-Run Preview -->
            <Grid x:Name="ViewStage3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Safety Guard &amp; Pre-Execution Check" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Ensure system recovery safeguards are engaged before modifying any Windows state." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Safety Options -->
                <Border Grid.Row="1" Background="#131D31" CornerRadius="8" BorderBrush="#2A384F" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="ChkCreateRestorePoint" Style="{StaticResource ModernCheckBox}" Content="Create Windows System Restore Point (Recommended)" IsChecked="True" FontWeight="Bold"/>
                        <TextBlock Text="Creates an immediate restore point checkpoint allowing rollback through Windows Recovery if needed." FontSize="12" Foreground="#94A3B8" Margin="24,0,0,10"/>

                        <CheckBox x:Name="ChkRegistrySnapshot" Style="{StaticResource ModernCheckBox}" Content="Capture Pre-Tweak Registry Snapshot to Local Storage" IsChecked="True" FontWeight="Bold"/>
                        <TextBlock Text="Captures exact original values of all targeted registry keys into %LOCALAPPDATA%\NHWinDebloater\Backups\." FontSize="12" Foreground="#94A3B8" Margin="24,0,0,10"/>
                    </StackPanel>
                </Border>

                <!-- Dry-Run Preview Box -->
                <Border Grid.Row="2" Background="#0A0E17" CornerRadius="8" BorderBrush="#2A384F" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnRunDryRun" Style="{StaticResource ModernBtn}" Content="▶ Run Dry-Run Preview (WhatIf)" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtDryRunStatus" Text="Click to simulate changes without applying anything." VerticalAlignment="Center" FontSize="12" Foreground="#38BDF8"/>
                        </StackPanel>
                        <TextBox x:Name="TxtDryRunLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#0A0E17" Foreground="#E2E8F0" FontFamily="Consolas, Lucida Console" FontSize="12" BorderThickness="0" Padding="8"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- STAGE 4: Execution & Real-Time Progress -->
            <Grid x:Name="ViewStage4" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Executing Debloat Pipeline..." FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="TxtProgressStatus" Text="Initializing requested operations..." FontSize="13" Foreground="#38BDF8"/>
                </StackPanel>

                <ProgressBar x:Name="ProgExecution" Grid.Row="1" Height="10" Maximum="100" Value="0" Background="#131D31" Foreground="#0EA5E9" Margin="0,0,0,16"/>

                <Border Grid.Row="2" Background="#0A0E17" CornerRadius="8" BorderBrush="#2A384F" BorderThickness="1" Padding="12">
                    <TextBox x:Name="TxtLiveLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#E2E8F0" FontFamily="Consolas, Lucida Console" FontSize="12" BorderThickness="0"/>
                </Border>
            </Grid>

            <!-- STAGE 5: Summary & Completion -->
            <Grid x:Name="ViewStage5" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="Optimization Complete!" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                    <TextBlock Text="Your Windows environment has been debloated and optimized cleanly." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#131D31" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total Operations" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtStatTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#131D31" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Successfully Applied" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtStatSuccess" Text="0" FontSize="26" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#131D31" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Skipped / Safeguarded" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtStatSkipped" Text="0" FontSize="26" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="#131D31" CornerRadius="8" BorderBrush="#2A384F" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Recommended Next Steps:" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                            <TextBlock Text="• Restart Windows Explorer to immediately refresh Taskbar and desktop icons." FontSize="13" Foreground="#CBD5E1" Margin="0,2"/>
                            <TextBlock Text="• Check the session log for full granular execution details." FontSize="13" Foreground="#CBD5E1" Margin="0,2"/>
                            <TextBlock Text="• If you ever need to restore default Store apps, run Option 7 in the CLI runner." FontSize="13" Foreground="#CBD5E1" Margin="0,2"/>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <Button x:Name="BtnRestartExplorer" Style="{StaticResource ModernBtn}" Content="↻ Restart Explorer" Margin="0,0,10,0"/>
                                <Button x:Name="BtnOpenLog" Style="{StaticResource ModernBtn}" Content="📄 Open Session Log" Margin="0,0,10,0"/>
                                <Button x:Name="BtnOpenBackups" Style="{StaticResource ModernBtn}" Content="🛡 Open Backups Folder" Margin="0,0,10,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

        </Grid>

        <!-- 4. Footer Bar & Navigation -->
        <Border Grid.Row="3" Background="#131D31" BorderBrush="#2A384F" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- NH Digital Promo Link (Non-Intrusive) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡ Powered by " FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center">
                        <Hyperlink x:Name="LinkNhDigital" NavigateUri="https://nhdigital.shop" Foreground="#0EA5E9" TextDecorations="None">
                            <Bold>NH Digital</Bold>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text=" — Explore software tools &amp; presets at nhdigital.shop" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Style="{StaticResource ModernBtn}" Content="← Back" Margin="0,0,10,0" Visibility="Collapsed"/>
                    <Button x:Name="BtnNext" Style="{StaticResource PrimaryBtn}" Content="Continue →"/>
                    <Button x:Name="BtnApply" Style="{StaticResource PrimaryBtn}" Content="⚡ Apply Debloat" Visibility="Collapsed" Background="#10B981" BorderBrush="#10B981"/>
                    <Button x:Name="BtnFinish" Style="{StaticResource PrimaryBtn}" Content="Finish &amp; Exit" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
