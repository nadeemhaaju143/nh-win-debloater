                                            <Path Data="{StaticResource IconClose}" Fill="#F87171" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Deselect All" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnInvertSelection" Style="{StaticResource ModernBtn}" Margin="0,0,0,0" Padding="10,4" ToolTip="Invert selection: Toggle all currently visible bloatware apps">
