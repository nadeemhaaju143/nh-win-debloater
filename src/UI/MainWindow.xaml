                        <TransformGroup>
                            <TranslateTransform Y="0"/>
                            <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                        </TransformGroup>
                    </TabControl.RenderTransform>
                    <!-- Tab 1: Bloatware Apps -->
