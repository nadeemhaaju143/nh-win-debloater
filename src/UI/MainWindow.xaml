                            <TextBlock Text="Back" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnNext" Style="{StaticResource PrimaryBtn}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Next" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Path Data="{StaticResource IconArrowForward}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnApply" Style="{StaticResource PrimaryBtn}" Visibility="Collapsed" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLightning}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Apply Optimizations" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnFinish" Style="{StaticResource PrimaryBtn}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconCheckCircle}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Finish &amp; Exit" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
