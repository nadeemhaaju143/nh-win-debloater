                                        <CheckBox x:Name="ChkNotepadAI" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Microsoft Notepad Cowriter &amp; AI text generation features" IsChecked="True"/>
                                        <Border Grid.Column="1" Background="#78350F" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconAlertTriangle}" Fill="#FBBF24" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="CAUTION" FontSize="9" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Tab 7: Optional Features -->
                    <TabItem FontWeight="SemiBold">
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconLayersFeatures}" Fill="#38BDF8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Optional Features" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Border Background="#1A2234" CornerRadius="8" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTabFeaturesCount" Text="0/2" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                </Border>
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar: Dark Multi-Select Batch Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <ToggleButton x:Name="ToggleFeaturesPresets" Style="{StaticResource ModernDropdownToggle}" MinWidth="180">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtToggleFeaturesText" Text="Presets: Optional Features" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <Path Data="{StaticResource IconChevronDown}" Fill="#38BDF8" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </ToggleButton>
                                    <Popup x:Name="PopupFeaturesPresets" PlacementTarget="{Binding ElementName=ToggleFeaturesPresets}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=ToggleFeaturesPresets}" StaysOpen="False" PopupAnimation="Fade" AllowsTransparency="True">
                                        <Border Background="#131926" BorderBrush="#232D42" BorderThickness="1" CornerRadius="10" Padding="12" MinWidth="260">
                                            <Border.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                                    <TranslateTransform Y="-4"/>
                                                </TransformGroup>
                                            </Border.RenderTransform>
                                            <Border.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" From="0.95" To="1.0" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" From="0.95" To="1.0" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" From="-4" To="0" Duration="0:0:0.18">
                                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Border.Triggers>
                                            <StackPanel>
                                                <TextBlock Text="Select Optional Features:" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                                <CheckBox x:Name="ChkFeatSandbox" Style="{StaticResource ModernCheckBox}" Content="Windows Sandbox (Disposable VM)" IsChecked="False"/>
                                                <CheckBox x:Name="ChkFeatWSL" Style="{StaticResource ModernCheckBox}" Content="Windows Subsystem for Linux (WSL)" IsChecked="False"/>
                                                <Border BorderBrush="#232D42" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button x:Name="BtnFeatSelectAll" Style="{StaticResource ModernBtn}" Content="Check All" Padding="8,2" Margin="0,0,6,0"/>
                                                    <Button x:Name="BtnFeatClear" Style="{StaticResource ModernBtn}" Content="Clear" Padding="8,2"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnSelectAllFeatures" Style="{StaticResource ModernBtn}" Margin="0,0,6,0" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconCheckDouble}" Fill="#34D399" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Select All" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnDeselectAllFeatures" Style="{StaticResource ModernBtn}" Padding="10,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconClose}" Fill="#F87171" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Deselect All" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Optional Windows Components:" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkWindowsSandbox" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Enable Windows Sandbox (Lightweight disposable virtual desktop)" IsChecked="False"/>
                                        <Border Grid.Column="1" Background="#881337" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconAlertOctagon}" Fill="#F87171" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="HIGH IMPACT" FontSize="9" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkWSL" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Enable Windows Subsystem for Linux (WSL)" IsChecked="False"/>
                                        <Border Grid.Column="1" Background="#881337" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconAlertOctagon}" Fill="#F87171" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="HIGH IMPACT" FontSize="9" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Note: Enabling optional Windows features requires system virtualization support (VT-x/AMD-V)." FontSize="11" Foreground="#94A3B8" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- STAGE 3: Safety & Dry-Run Preview -->
            <Grid x:Name="ViewStage3" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="0" Y="0"/>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Safety Guard &amp; Pre-Execution Check" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Review recovery safeguards and run an optional WhatIf preview simulation." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Live Target Execution Plan & Overall Safety Rating Card -->
                <Border Grid.Row="1" Background="#131926" CornerRadius="8" BorderBrush="#232D42" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Target Execution Plan:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtStage3Summary" Text="84 Bloatware Apps • 18 System Tweaks Queued (102 Operations)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="BadgeStage3Impact" Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="12,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="IconStage3Impact" Data="{StaticResource IconCheckCircle}" Fill="#34D399" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtStage3Impact" Text="SAFETY RATING: LOW / SAFE" FontSize="12" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Safety Options -->
                <Border Grid.Row="2" Background="#131926" CornerRadius="8" BorderBrush="#232D42" BorderThickness="1" Padding="14,10" Margin="0,0,0,10">
                    <StackPanel>
                        <CheckBox x:Name="ChkCreateRestorePoint" Style="{StaticResource ModernCheckBox}" Content="Create Windows System Restore Point checkpoint" IsChecked="True" FontWeight="Bold"/>
                        <CheckBox x:Name="ChkRegistrySnapshot" Style="{StaticResource ModernCheckBox}" Content="Capture Pre-Tweak Registry Snapshot to %LOCALAPPDATA%\NHWinDebloater\Backups\" IsChecked="True" FontWeight="Bold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Dry-Run Preview Box -->
                <Border Grid.Row="3" Background="#0B0F17" CornerRadius="8" BorderBrush="#232D42" BorderThickness="1" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnRunDryRun" Style="{StaticResource ModernBtn}" Margin="0,0,10,0" Padding="12,5">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlay}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Run Dry-Run Preview (WhatIf)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="TxtDryRunStatus" Text="Click to simulate changes without applying anything." VerticalAlignment="Center" FontSize="12" Foreground="#38BDF8"/>
                        </StackPanel>
                        <TextBox x:Name="TxtDryRunLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#0B0F17" Foreground="#E2E8F0" FontFamily="Consolas, Lucida Console" FontSize="12" BorderThickness="0" Padding="8"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- STAGE 4: Execution & Real-Time Progress -->
            <Grid x:Name="ViewStage4" Visibility="Collapsed">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="0" Y="0"/>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Applying Optimizations &amp; Debloating" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="TxtProgressStatus" Text="Processing queue..." FontSize="13" Foreground="#38BDF8"/>
                </StackPanel>

                <ProgressBar x:Name="ProgExecution" Grid.Row="1" Height="8" Background="#1A2234" Foreground="#0EA5E9" Margin="0,0,0,16"/>

                <Border Grid.Row="2" Background="#0B0F17" CornerRadius="8" BorderBrush="#232D42" BorderThickness="1" Padding="14">
                    <TextBox x:Name="TxtLiveLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#0B0F17" Foreground="#E2E8F0" FontFamily="Consolas, Lucida Console" FontSize="12" BorderThickness="0"/>
                </Border>
            </Grid>

            <!-- STAGE 5: Summary & Post-Optimization -->
            <Grid x:Name="ViewStage5" Visibility="Collapsed" ClipToBounds="False">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="0" Y="0"/>
                        <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Optimization Complete!" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                    <TextBlock Text="All selected debloating steps, registry policies, and tweaks have executed." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>

                <Grid Grid.Row="1" ClipToBounds="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Metrics Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#131926" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total Tasks Processed" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtStatTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#131926" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Successfully Applied" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtStatSuccess" Text="0" FontSize="26" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#131926" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Skipped / Safeguarded" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtStatSkipped" Text="0" FontSize="26" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="#131926" CornerRadius="8" BorderBrush="#232D42" BorderThickness="1" Padding="18" ClipToBounds="False">
                        <StackPanel ClipToBounds="False">
                            <TextBlock Text="Recommended Next Steps:" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                            <TextBlock Text="• Restart Windows Explorer to immediately refresh Taskbar and desktop icons." FontSize="13" Foreground="#CBD5E1" Margin="0,2"/>
                            <TextBlock Text="• For complete policy enforcement (Fast Startup / Driver exclusions), a system reboot is recommended." FontSize="13" Foreground="#CBD5E1" Margin="0,2"/>
                            <TextBlock Text="• Review session execution log file or backup snapshots at any time." FontSize="13" Foreground="#CBD5E1" Margin="0,2"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,16">
                                <Button x:Name="BtnRestartExplorer" Style="{StaticResource ModernBtn}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconRefresh}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Restart Explorer" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnOpenLog" Style="{StaticResource ModernBtn}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFileText}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="View Execution Log" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnOpenBackups" Style="{StaticResource ModernBtn}" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconFolder}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Open Backups Folder" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStage5ReinstallApps" Style="{StaticResource ModernBtn}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconAppGrid}" Fill="#38BDF8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Reinstall Built-in Apps" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Registry Snapshots & 1-Click Rollback Manager Card -->
                            <Border Background="#0B0F17" CornerRadius="8" BorderBrush="#232D42" BorderThickness="1" Padding="14" ClipToBounds="False">
                                <Grid ClipToBounds="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                        <Path Data="{StaticResource IconShieldLock}" Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Registry Snapshots &amp; Selective Rollback Manager" FontWeight="Bold" FontSize="13" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Grid Grid.Row="1" Margin="0,0,0,8" ClipToBounds="False">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CboRegistrySnapshots" Grid.Column="0" Height="32" MinHeight="32" MaxDropDownHeight="240" Background="#1E1E2E" Foreground="#F8FAFC" BorderBrush="#3B4261" BorderThickness="1" Margin="0,0,8,0" VerticalContentAlignment="Center" FontSize="11">
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="Background" Value="#1E1E2E"/>
                                                    <Setter Property="Foreground" Value="#F8FAFC"/>
                                                    <Setter Property="Padding" Value="8,6"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="BorderBrush" Value="#232D42"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsHighlighted" Value="True">
                                                            <Setter Property="Background" Value="#0EA5E9"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#0284C7"/>
                                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>
                                        <Button x:Name="BtnRefreshSnapshots" Grid.Column="1" Style="{StaticResource ModernBtn}" Height="32" Padding="8,0" Margin="0,0,8,0" ToolTip="Refresh snapshot list">
                                            <Path Data="{StaticResource IconRefresh}" Fill="#38BDF8" Width="11" Height="11" Stretch="Uniform"/>
                                        </Button>

                                        <!-- Multi-Select Scope Dropdown -->
                                        <Grid Grid.Column="2">
                                            <ToggleButton x:Name="ToggleSelectiveRestore" Style="{StaticResource ModernDropdownToggle}" MinWidth="220">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource IconCheckDouble}" Fill="#38BDF8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TxtToggleSelectiveRestoreText" Text="Scope: All Tweaks &amp; Apps" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <Path Data="{StaticResource IconChevronDown}" Fill="#38BDF8" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </ToggleButton>
                                            <Popup x:Name="PopupSelectiveRestore" PlacementTarget="{Binding ElementName=ToggleSelectiveRestore}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=ToggleSelectiveRestore}" StaysOpen="False" PopupAnimation="Fade" AllowsTransparency="True">
                                                <Border Background="#131926" BorderBrush="#232D42" BorderThickness="1" CornerRadius="10" Padding="12" MinWidth="260">
                                                    <StackPanel>
                                                        <TextBlock Text="Select Restore Scope:" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                                        <CheckBox x:Name="ChkRestoreScopeApps" Style="{StaticResource ModernCheckBox}" Content="Reinstall Removed Built-in Apps" IsChecked="True"/>
                                                        <CheckBox x:Name="ChkRestoreScopePrivacy" Style="{StaticResource ModernCheckBox}" Content="Privacy &amp; Diagnostic Policies" IsChecked="True"/>
                                                        <CheckBox x:Name="ChkRestoreScopeShell" Style="{StaticResource ModernCheckBox}" Content="Taskbar, Explorer &amp; Context Menu" IsChecked="True"/>
                                                        <CheckBox x:Name="ChkRestoreScopeGaming" Style="{StaticResource ModernCheckBox}" Content="Gaming &amp; Performance Settings" IsChecked="True"/>
                                                        <CheckBox x:Name="ChkRestoreScopeAI" Style="{StaticResource ModernCheckBox}" Content="AI Integration (Copilot/Recall/Apps)" IsChecked="True"/>
                                                        <CheckBox x:Name="ChkRestoreScopeExtras" Style="{StaticResource ModernCheckBox}" Content="System Extras &amp; Hardware Policies" IsChecked="True"/>
                                                        <Border BorderBrush="#232D42" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                                <Button x:Name="BtnRestoreScopeTweaksOnly" Style="{StaticResource ModernBtn}" Content="Tweaks Only" Padding="6,2" Margin="0,0,4,0" ToolTip="Restore all registry tweaks without reinstalling apps"/>
                                                                <Button x:Name="BtnRestoreScopeAppsOnly" Style="{StaticResource ModernBtn}" Content="Apps Only" Padding="6,2" ToolTip="Only reinstall removed applications"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                <Button x:Name="BtnRestoreScopeAll" Style="{StaticResource ModernBtn}" Content="All" Padding="6,2" Margin="0,0,4,0"/>
                                                                <Button x:Name="BtnRestoreScopeClear" Style="{StaticResource ModernBtn}" Content="Clear" Padding="6,2"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Grid>

                                    <!-- Row 2: Actions Row -->
                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="BtnPreviewSnapshot" Grid.Column="0" Style="{StaticResource ModernBtn}" Height="32" Padding="12,0" Margin="0,0,8,0" ToolTip="Preview registry keys and apps eligible for restore without modifying anything">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconPlay}" Fill="#38BDF8" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
