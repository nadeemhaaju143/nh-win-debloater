<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NH Win Debloater - Guided Setup Assistant"
    Height="760" Width="1080"
    MinHeight="680" MinWidth="980"
    WindowStartupLocation="CenterScreen"
    Background="#0A0E17" Foreground="#F8FAFC"
    FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Window.Resources>
        <!-- Material Dark Palette & Surface Elevations -->
        <SolidColorBrush x:Key="BgDark" Color="#0A0E17"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#131D31"/>
        <SolidColorBrush x:Key="SurfaceElevated" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2A384F"/>
        <SolidColorBrush x:Key="CardBorderSubtle" Color="#1E293B"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="AccentCyanGlow" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentEmerald" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentRose" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#64748B"/>

        <!-- Crisp SVG Vector Icon Geometries -->
        <Geometry x:Key="IconAppGrid">M4,4H10V10H4V4M14,4H20V10H14V4M4,14H10V20H4V14M14,14H20V20H14V14Z</Geometry>
        <Geometry x:Key="IconShieldLock">M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z</Geometry>
        <Geometry x:Key="IconDesktopExplorer">M19,3H5C3.89,3 3,3.89 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V5C21,3.89 20.1,3 19,3M19,19H5V7H19V19Z</Geometry>
        <Geometry x:Key="IconGamepadGaming">M7,6H17L12,1L7,6M15,7.5V2H9V7.5H3.5V13.5H9V19H15V13.5H20.5V7.5H15Z</Geometry>
        <Geometry x:Key="IconSettingsExtras">M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.65 15.48,5.32 14.87,5.07L14.49,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.51,2.42L9.13,5.07C8.52,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.52,18.68 9.13,18.93L9.51,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.49,21.58L14.87,18.93C15.48,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z</Geometry>
        <Geometry x:Key="IconSparklesAI">M7.5,5.6L5,7L6.4,4.5L5,2L7.5,3.4L10,2L8.6,4.5L10,7L7.5,5.6M19.5,15.4L22,14L20.6,16.5L22,19L19.5,17.6L17,19L18.4,16.5L17,14L19.5,15.4M22,2L20.6,4.5L22,7L19.5,5.6L17,7L18.4,4.5L17,2L19.5,3.4L22,2M13.34,12.78L15.78,10.34L13.66,8.22L11.22,10.66L13.34,12.78M14.37,7.29L16.71,9.63C17.1,10 17.1,10.65 16.71,11.04L11.04,16.71C10.65,17.1 10,17.1 9.63,16.71L7.29,14.37C6.9,14 6.9,13.35 7.29,12.96L12.96,7.29C13.35,6.9 14,6.9 14.37,7.29Z</Geometry>
        <Geometry x:Key="IconLayersFeatures">M12,2L1,7L12,12L23,7L12,2M1,12L12,17L23,12L23,14L12,19L1,14L1,12M1,17L12,22L23,17L23,19L12,24L1,19L1,17Z</Geometry>
        <Geometry x:Key="IconCheckCircle">M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M10,17L18,9L16.59,7.58L10,14.17L7.41,11.59L6,13L10,17Z</Geometry>
        <Geometry x:Key="IconAlertTriangle">M12,2L1,21H23L12,2M12,6L19.53,19H4.47L12,6M11,10V14H13V10H11M11,16V18H13V16H11Z</Geometry>
        <Geometry x:Key="IconAlertOctagon">M8.27,3L3,8.27V15.73L8.27,21H15.73L21,15.73V8.27L15.73,3M8.41,5H15.59L19,8.41V15.59L15.59,19H8.41L5,15.59V8.41M11,7H13V13H11M11,15H13V17H11Z</Geometry>
        <Geometry x:Key="IconChevronDown">M7,10L12,15L17,10H7Z</Geometry>
        <Geometry x:Key="IconCheckDouble">M0.5,8L3,10.5L9.5,4L8,2.5L3,7.5L2,6.5L0.5,8M5.5,8L8,10.5L14.5,4L13,2.5L8,7.5L7,6.5L5.5,8Z</Geometry>
        <Geometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>
        <Geometry x:Key="IconPlay">M8,5.14V19.14L19,12.14L8,5.14Z</Geometry>
        <Geometry x:Key="IconArrowBack">M15.41,7.41L14,6L8,12L14,18L15.41,16.59L10.83,12L15.41,7.41Z</Geometry>
        <Geometry x:Key="IconArrowForward">M10,6L8.59,7.41L13.17,12L8.59,16.59L10,18L16,12L10,6Z</Geometry>
        <Geometry x:Key="IconLightning">M11,15H6L13,1V9H18L11,23V15Z</Geometry>
        <Geometry x:Key="IconRefresh">M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z</Geometry>
        <Geometry x:Key="IconFolder">M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z</Geometry>
        <Geometry x:Key="IconFileText">M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z</Geometry>

        <!-- Interactive Preset Card Styles with Hover Transitions -->
        <Style x:Key="PresetCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#131D31"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#2A384F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#0EA5E9"/>
                    <Setter Property="Background" Value="#17233B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PresetCardRecommendedBorder" TargetType="Border">
            <Setter Property="Background" Value="#131D31"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#0EA5E9"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Setter Property="Background" Value="#17233B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A384F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="BorderBrush" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38BDF8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- Dark Material Multi-Select Dropdown ToggleButton -->
        <Style x:Key="ModernDropdownToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A384F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A384F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Popup Action Item Button -->
        <Style x:Key="DropdownActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2A384F"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Crisp TabItem Styling with Dark Material Active Underline -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter TargetName="tabBorder" Property="Background" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter TargetName="tabBorder" Property="Background" Value="#131D31"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>  <!-- Header -->
            <RowDefinition Height="46"/>  <!-- Step Indicator -->
            <RowDefinition Height="*"/>   <!-- Main Dynamic Views -->
            <RowDefinition Height="64"/>  <!-- Footer & Navigation -->
        </Grid.RowDefinitions>

        <!-- 1. Header Bar with Accent Shimmer & Status Flourish -->
        <Border Grid.Row="0" Background="#131D31" BorderBrush="#2A384F" BorderThickness="0,0,0,1">
            <Grid>
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo Area -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="LogoFallbackBox" Width="38" Height="38" CornerRadius="8" Background="#0EA5E9" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="NH" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image x:Name="ImgLogo" MaxWidth="120" MaxHeight="38" Stretch="Uniform" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,14,0"/>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NH Win Debloater" FontWeight="Bold" FontSize="18" Foreground="#F8FAFC"/>
                                <Border x:Name="BadgeVersion" CornerRadius="4" Background="#0284C7" Margin="10,2,0,2" Padding="6,1">
                                    <TextBlock x:Name="TxtVersion" Text="v0.4" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Less Bloat. Better Windows. Built for performance." FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- System Info & Status Flourish -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtOsCaption" Text="Windows 11 Pro" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                            <Ellipse x:Name="DotElevationStatus" Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtElevationStatus" Text="Elevated Administrator" FontSize="11" Foreground="#10B981" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Modern Cyan/Indigo Accent Shimmer Line -->
                <Border Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#000EA5E9" Offset="0.0"/>
                            <GradientStop Color="#FF0EA5E9" Offset="0.25"/>
                            <GradientStop Color="#FF38BDF8" Offset="0.5"/>
                            <GradientStop Color="#FF6366F1" Offset="0.75"/>
                            <GradientStop Color="#006366F1" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Step Indicator Bar -->
        <Border Grid.Row="1" Background="#0A0E17" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StepTag1" Text="1. Presets &amp; Scope" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,0,20,0"/>
                <TextBlock Text="›" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock x:Name="StepTag2" Text="2. Select Bloat &amp; Tweaks" FontWeight="Normal" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock Text="›" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock x:Name="StepTag3" Text="3. Safety &amp; Dry-Run" FontWeight="Normal" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock Text="›" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock x:Name="StepTag4" Text="4. Execution" FontWeight="Normal" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock Text="›" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock x:Name="StepTag5" Text="5. Summary" FontWeight="Normal" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- 3. Dynamic Wizard Views -->
        <Grid Grid.Row="2" Margin="24,18">

            <!-- STAGE 1: Presets & Mode Selection -->
            <Grid x:Name="ViewStage1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Select Optimization Profile &amp; Target Scope" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Choose a baseline debloat preset to get started. You can inspect and fine-tune every package in the next step." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Preset Cards Grid with Interactive Motion Hover -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Minimal Card -->
                    <Border x:Name="CardPresetMinimal" Grid.Column="0" Style="{StaticResource PresetCardBorder}" Margin="0,0,10,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="RadioPresetMinimal" Content="Minimal Debloat" FontWeight="Bold" FontSize="15" GroupName="PresetGroup" Foreground="#F8FAFC"/>
                            <TextBlock Grid.Row="1" Text="Lightweight &amp; Gentle" FontSize="12" Foreground="#38BDF8" Margin="0,6,0,12"/>
                            <TextBlock Grid.Row="2" Text="Removes sponsored apps (TikTok, Spotify, Disney+) while keeping all Windows utilities, Xbox, and productivity apps untouched." TextWrapping="Wrap" FontSize="13" Foreground="#CBD5E1"/>
                            <Border Grid.Row="3" Background="#0A0E17" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconCheckCircle}" Fill="#10B981" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Best for enterprise &amp; cautious users" FontSize="11" Foreground="#10B981" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Default / Recommended Card -->
                    <Border x:Name="CardPresetDefault" Grid.Column="1" Style="{StaticResource PresetCardRecommendedBorder}" Margin="5,0,5,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="RadioPresetDefault" Content="Recommended Debloat" FontWeight="Bold" FontSize="15" IsChecked="True" GroupName="PresetGroup" Foreground="#F8FAFC"/>
                            <TextBlock Grid.Row="1" Text="Balanced Performance &amp; Privacy" FontSize="12" Foreground="#10B981" Margin="0,6,0,12"/>
                            <TextBlock Grid.Row="2" Text="Removes 80+ preinstalled bloatware packages, telemetry diagnostics, targeted ads, and web search suggestions. Protects all system-critical apps." TextWrapping="Wrap" FontSize="13" Foreground="#CBD5E1"/>
                            <Border Grid.Row="3" Background="#0A0E17" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconLightning}" Fill="#38BDF8" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Recommended for most PCs &amp; gamers" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Deep Debloat Card -->
                    <Border x:Name="CardPresetDeep" Grid.Column="2" Style="{StaticResource PresetCardBorder}" Margin="10,0,0,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="RadioPresetDeep" Content="Deep Debloat" FontWeight="Bold" FontSize="15" GroupName="PresetGroup" Foreground="#F8FAFC"/>
