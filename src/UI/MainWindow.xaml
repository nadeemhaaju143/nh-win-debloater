<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NH Win Debloater - Guided Setup Assistant"
    Height="760" Width="1080"
    MinHeight="680" MinWidth="980"
    WindowStartupLocation="CenterScreen"
    Background="#0A0E17" Foreground="#F8FAFC"
    FontFamily="Segoe UI, Segoe UI Variable, Arial">

    <Window.Resources>
        <!-- Material Dark Palette & Surface Elevations -->
        <SolidColorBrush x:Key="BgDark" Color="#0A0E17"/>
        <SolidColorBrush x:Key="SurfaceCard" Color="#131D31"/>
        <SolidColorBrush x:Key="SurfaceElevated" Color="#1E293B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#2A384F"/>
        <SolidColorBrush x:Key="CardBorderSubtle" Color="#1E293B"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#0EA5E9"/>
        <SolidColorBrush x:Key="AccentCyanGlow" Color="#38BDF8"/>
        <SolidColorBrush x:Key="AccentEmerald" Color="#10B981"/>
        <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
        <SolidColorBrush x:Key="AccentRose" Color="#EF4444"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="TextTertiary" Color="#64748B"/>

        <!-- Button Style -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A384F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Accent Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#0EA5E9"/>
            <Setter Property="BorderBrush" Value="#0EA5E9"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#38BDF8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- Dark Material Multi-Select Dropdown ToggleButton -->
        <Style x:Key="ModernDropdownToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" CornerRadius="5" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A384F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#0EA5E9"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A384F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#38BDF8"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dropdown Popup Action Item Button -->
        <Style x:Key="DropdownActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#2A384F"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>  <!-- Header -->
            <RowDefinition Height="46"/>  <!-- Step Indicator -->
            <RowDefinition Height="*"/>   <!-- Main Dynamic Views -->
            <RowDefinition Height="64"/>  <!-- Footer & Navigation -->
        </Grid.RowDefinitions>

        <!-- 1. Header Bar with Accent Shimmer & Status Flourish -->
        <Border Grid.Row="0" Background="#131D31" BorderBrush="#2A384F" BorderThickness="0,0,0,1">
            <Grid>
                <Grid Margin="24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo Area -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="LogoFallbackBox" Width="38" Height="38" CornerRadius="8" Background="#0EA5E9" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="NH" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Image x:Name="ImgLogo" MaxWidth="120" MaxHeight="38" Stretch="Uniform" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,14,0"/>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="NH Win Debloater" FontWeight="Bold" FontSize="18" Foreground="#F8FAFC"/>
                                <Border x:Name="BadgeVersion" CornerRadius="4" Background="#0284C7" Margin="10,2,0,2" Padding="6,1">
                                    <TextBlock x:Name="TxtVersion" Text="v0.4" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Less Bloat. Better Windows. Built for performance." FontSize="12" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- System Info & Status Flourish -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtOsCaption" Text="Windows 11 Pro" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                            <Ellipse x:Name="DotElevationStatus" Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtElevationStatus" Text="Elevated Administrator" FontSize="11" Foreground="#10B981" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Modern Cyan/Indigo Accent Shimmer Line -->
                <Border Height="2" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#000EA5E9" Offset="0.0"/>
                            <GradientStop Color="#FF0EA5E9" Offset="0.25"/>
                            <GradientStop Color="#FF38BDF8" Offset="0.5"/>
                            <GradientStop Color="#FF6366F1" Offset="0.75"/>
                            <GradientStop Color="#006366F1" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Step Indicator Bar -->
        <Border Grid.Row="1" Background="#0A0E17" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="24,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="StepTag1" Text="1. Presets &amp; Scope" FontWeight="Bold" Foreground="#0EA5E9" Margin="0,0,20,0"/>
                <TextBlock Text="›" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock x:Name="StepTag2" Text="2. Select Bloat &amp; Tweaks" FontWeight="Normal" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock Text="›" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock x:Name="StepTag3" Text="3. Safety &amp; Dry-Run" FontWeight="Normal" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock Text="›" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock x:Name="StepTag4" Text="4. Execution" FontWeight="Normal" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock Text="›" Foreground="#64748B" Margin="0,0,20,0"/>
                <TextBlock x:Name="StepTag5" Text="5. Summary" FontWeight="Normal" Foreground="#64748B"/>
            </StackPanel>
        </Border>

        <!-- 3. Dynamic Wizard Views -->
        <Grid Grid.Row="2" Margin="24,18">

            <!-- STAGE 1: Presets & Mode Selection -->
            <Grid x:Name="ViewStage1" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Select Optimization Profile &amp; Target Scope" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Choose a baseline debloat preset to get started. You can inspect and fine-tune every package in the next step." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Preset Cards Grid -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Minimal Card -->
                    <Border Grid.Column="0" Background="#131D31" CornerRadius="8" BorderBrush="#2A384F" BorderThickness="1" Margin="0,0,10,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="RadioPresetMinimal" Content="Minimal Debloat" FontWeight="Bold" FontSize="15" GroupName="PresetGroup" Foreground="#F8FAFC"/>
                            <TextBlock Grid.Row="1" Text="Lightweight &amp; Gentle" FontSize="12" Foreground="#38BDF8" Margin="0,6,0,12"/>
                            <TextBlock Grid.Row="2" Text="Removes sponsored apps (TikTok, Spotify, Disney+) while keeping all Windows utilities, Xbox, and productivity apps untouched." TextWrapping="Wrap" FontSize="13" Foreground="#CBD5E1"/>
                            <Border Grid.Row="3" Background="#0A0E17" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                                <TextBlock Text="✓ Best for enterprise &amp; cautious users" FontSize="11" Foreground="#10B981"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Default / Recommended Card -->
                    <Border Grid.Column="1" Background="#131D31" CornerRadius="8" BorderBrush="#0EA5E9" BorderThickness="2" Margin="5,0,5,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="RadioPresetDefault" Content="Recommended Debloat" FontWeight="Bold" FontSize="15" IsChecked="True" GroupName="PresetGroup" Foreground="#F8FAFC"/>
                            <TextBlock Grid.Row="1" Text="Balanced Performance &amp; Privacy" FontSize="12" Foreground="#10B981" Margin="0,6,0,12"/>
                            <TextBlock Grid.Row="2" Text="Removes 80+ preinstalled bloatware packages, telemetry diagnostics, targeted ads, and web search suggestions. Protects all system-critical apps." TextWrapping="Wrap" FontSize="13" Foreground="#CBD5E1"/>
                            <Border Grid.Row="3" Background="#0A0E17" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                                <TextBlock Text="★ Recommended for most PCs &amp; gamers" FontSize="11" Foreground="#38BDF8"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Deep Debloat Card -->
                    <Border Grid.Column="2" Background="#131D31" CornerRadius="8" BorderBrush="#2A384F" BorderThickness="1" Margin="10,0,0,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <RadioButton x:Name="RadioPresetDeep" Content="Deep Debloat" FontWeight="Bold" FontSize="15" GroupName="PresetGroup" Foreground="#F8FAFC"/>
                            <TextBlock Grid.Row="1" Text="Maximum Performance" FontSize="12" Foreground="#EAB308" Margin="0,6,0,12"/>
                            <TextBlock Grid.Row="2" Text="Thorough debloating including optional Microsoft productivity utilities (OneNote, Sticky Notes, Voice Recorder). Fully customizable in the next step." TextWrapping="Wrap" FontSize="13" Foreground="#CBD5E1"/>
                            <Border Grid.Row="3" Background="#0A0E17" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                                <TextBlock Text="⚠ Recommended for power users" FontSize="11" Foreground="#F59E0B"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Target Scope Bar -->
                <Border Grid.Row="2" Background="#131D31" CornerRadius="6" BorderBrush="#2A384F" BorderThickness="1" Padding="14,10" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Target Scope:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="#F8FAFC"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="RadioScopeAllUsers" Content="All Users (Recommended)" IsChecked="True" GroupName="ScopeGroup" Foreground="#F8FAFC" Margin="0,0,18,0"/>
                            <RadioButton x:Name="RadioScopeCurrentUser" Content="Current User Only" GroupName="ScopeGroup" Foreground="#CBD5E1" Margin="0,0,18,0"/>
                            <RadioButton x:Name="RadioScopeDefaultUser" Content="Default User / Sysprep (Provisioned Only)" GroupName="ScopeGroup" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- STAGE 2: App & Tweak Selection -->
            <Grid x:Name="ViewStage2" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Refine Packages &amp; System Tweaks" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <TextBlock Text="Batch-select multi-category packages and configure system optimization tweaks." FontSize="13" Foreground="#94A3B8"/>
                    </StackPanel>
                    <TextBox x:Name="TxtAppFilter" Grid.Column="1" Width="220" Height="30" VerticalContentAlignment="Center" Padding="8,0" Background="#1E293B" Foreground="#F8FAFC" BorderBrush="#334155"/>
                </Grid>

                <TabControl Grid.Row="1" Background="#131D31" BorderBrush="#2A384F" Foreground="#F8FAFC">
                    <!-- Tab 1: Bloatware Apps -->
                    <TabItem Header="Bloatware Applications" FontWeight="SemiBold">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Power-User Toolbar: Dark Material Multi-Select CheckBox Dropdown -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Custom Dark Material Multi-Select Dropdown -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="Categories:" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Grid>
                                        <ToggleButton x:Name="ToggleAppCategories" Style="{StaticResource ModernDropdownToggle}" Content="Categories: Recommended (84 Apps) ▼" MinWidth="250"/>
                                        <Popup x:Name="PopupAppCategories" PlacementTarget="{Binding ElementName=ToggleAppCategories}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=ToggleAppCategories}" StaysOpen="False">
                                            <Border Background="#131D31" BorderBrush="#2A384F" BorderThickness="1" CornerRadius="6" Padding="12" MinWidth="280">
                                                <StackPanel>
                                                    <TextBlock Text="Select Bloatware Categories:" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                                    <CheckBox x:Name="ChkCatRecommended" Style="{StaticResource ModernCheckBox}" Content="Recommended Safe Bloat (84 Apps)" IsChecked="True"/>
                                                    <CheckBox x:Name="ChkCatMinimal" Style="{StaticResource ModernCheckBox}" Content="Minimal Sponsored Only (11 Apps)" IsChecked="False"/>
                                                    <CheckBox x:Name="ChkCatDeep" Style="{StaticResource ModernCheckBox}" Content="Deep Debloat (All 162 Packages)" IsChecked="False"/>
                                                    <CheckBox x:Name="ChkCatOem" Style="{StaticResource ModernCheckBox}" Content="OEM &amp; Third-Party Bloat" IsChecked="False"/>
                                                    <CheckBox x:Name="ChkCatXbox" Style="{StaticResource ModernCheckBox}" Content="Xbox &amp; Gaming Packages" IsChecked="False"/>
                                                    <CheckBox x:Name="ChkCatMedia" Style="{StaticResource ModernCheckBox}" Content="News, Weather &amp; Media" IsChecked="False"/>
                                                    <Border BorderBrush="#2A384F" BorderThickness="0,1,0,0" Margin="0,8,0,8"/>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button x:Name="BtnCatSelectAll" Style="{StaticResource ModernBtn}" Content="Check All" Padding="8,2" Margin="0,0,6,0"/>
                                                        <Button x:Name="BtnCatClear" Style="{StaticResource ModernBtn}" Content="Clear" Padding="8,2"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </StackPanel>

                                <!-- Only Installed Apps Filter -->
                                <CheckBox x:Name="ChkOnlyInstalled" Grid.Column="1" Style="{StaticResource ModernCheckBox}" Content="Only show installed apps" IsChecked="False" Margin="0,0,16,0"/>

                                <!-- Selection Action Buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnSelectAllApps" Style="{StaticResource ModernBtn}" Content="Select All" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button x:Name="BtnDeselectAllApps" Style="{StaticResource ModernBtn}" Content="Deselect All" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button x:Name="BtnInvertSelection" Style="{StaticResource ModernBtn}" Content="Invert" Margin="0,0,0,0" Padding="10,4"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TxtAppsSummary" Grid.Row="1" Text="Showing 84 apps selected for removal" VerticalAlignment="Center" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,8"/>

                            <Border Grid.Row="2" Background="#0A0E17" CornerRadius="6" BorderBrush="#2A384F" BorderThickness="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ListAppsContainer" Margin="10"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Privacy & Search -->
                    <TabItem Header="Privacy &amp; Search" FontWeight="SemiBold">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar: Dark Multi-Select Batch Actions -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <ToggleButton x:Name="TogglePrivacyPresets" Style="{StaticResource ModernDropdownToggle}" Content="Quick Presets ▼" MinWidth="140"/>
                                    <Popup x:Name="PopupPrivacyPresets" PlacementTarget="{Binding ElementName=TogglePrivacyPresets}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=TogglePrivacyPresets}" StaysOpen="False">
                                        <Border Background="#131D31" BorderBrush="#2A384F" BorderThickness="1" CornerRadius="6" Padding="10" MinWidth="240">
                                            <StackPanel>
                                                <TextBlock Text="Privacy Batch Presets:" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>
                                                <Button x:Name="BtnPrivacyRecommended" Style="{StaticResource DropdownActionBtn}" Content="• Recommended (Telemetry + Ads + Search)"/>
                                                <Button x:Name="BtnPrivacyStrict" Style="{StaticResource DropdownActionBtn}" Content="• Strict Privacy (All Settings Disabled)"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnSelectAllPrivacy" Style="{StaticResource ModernBtn}" Content="Select All" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button x:Name="BtnDeselectAllPrivacy" Style="{StaticResource ModernBtn}" Content="Deselect All" Padding="10,4"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkTelemetry" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Telemetry &amp; Diagnostic Data Collection (Security/Basic level)" IsChecked="True"/>
                                        <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkBingSearch" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Bing Web Search suggestions in Start Menu" IsChecked="True"/>
                                        <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkAdvertisingId" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Advertising ID tracking across installed apps" IsChecked="True"/>
                                        <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                    </Grid>
                                    <Grid Margin="0,4">
