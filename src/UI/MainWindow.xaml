                                    <ItemsControl x:Name="ListAppsContainer" Margin="10"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Bottom Safety Legend Bar -->
                            <Border Grid.Row="3" Background="#131926" BorderBrush="#232D42" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
