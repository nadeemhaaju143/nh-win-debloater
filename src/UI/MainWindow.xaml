                                                <TextBlock Text="Recommended" FontSize="10" FontWeight="Bold" Foreground="#10B981"/>
                                            </Border>
                                            <TextBlock Text="Safe bloatware recommended for removal" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                        </StackPanel>
