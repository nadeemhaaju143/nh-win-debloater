                                    <Border BorderBrush="#2A384F" BorderThickness="0,1,0,0" Margin="0,12,0,12"/>
                                    <TextBlock Text="Integrated Application AI Features:" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkEdgeAI" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Microsoft Edge Copilot &amp; AI sidebar integration" IsChecked="True"/>
                                        <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="#34D399"/></Border>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkPaintAI" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Microsoft Paint Cocreator &amp; Image Creator AI features" IsChecked="True"/>
                                        <Border Grid.Column="1" Background="#78350F" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="CAUTION" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/></Border>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkNotepadAI" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Microsoft Notepad Cowriter &amp; AI text generation features" IsChecked="True"/>
                                        <Border Grid.Column="1" Background="#78350F" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="CAUTION" FontSize="10" FontWeight="Bold" Foreground="#FBBF24"/></Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Tab 7: Optional Features -->
                    <TabItem Header="Optional Features" FontWeight="SemiBold">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar: Action Buttons -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnSelectAllFeatures" Style="{StaticResource ModernBtn}" Content="Select All" Margin="0,0,6,0" Padding="10,4"/>
                                    <Button x:Name="BtnDeselectAllFeatures" Style="{StaticResource ModernBtn}" Content="Deselect All" Padding="10,4"/>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Optional Windows Components:" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkWindowsSandbox" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Enable Windows Sandbox (Lightweight disposable virtual desktop)" IsChecked="False"/>
                                        <Border Grid.Column="1" Background="#881337" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="HIGH IMPACT" FontSize="10" FontWeight="Bold" Foreground="#F87171"/></Border>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkWSL" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Enable Windows Subsystem for Linux (WSL)" IsChecked="False"/>
                                        <Border Grid.Column="1" Background="#881337" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="HIGH IMPACT" FontSize="10" FontWeight="Bold" Foreground="#F87171"/></Border>
                                    </Grid>
                                    <TextBlock Text="Note: Enabling optional Windows features requires system virtualization support (VT-x/AMD-V)." FontSize="11" Foreground="#94A3B8" Margin="0,10,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- STAGE 3: Safety & Dry-Run Preview -->
            <Grid x:Name="ViewStage3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Safety Guard &amp; Pre-Execution Check" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="Ensure system recovery safeguards are engaged before modifying any Windows state." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>

                <!-- Safety Options -->
                <Border Grid.Row="1" Background="#131D31" CornerRadius="8" BorderBrush="#2A384F" BorderThickness="1" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox x:Name="ChkCreateRestorePoint" Style="{StaticResource ModernCheckBox}" Content="Create Windows System Restore Point (Recommended)" IsChecked="True" FontWeight="Bold"/>
                        <TextBlock Text="Creates an immediate restore point checkpoint allowing rollback through Windows Recovery if needed." FontSize="12" Foreground="#94A3B8" Margin="24,0,0,10"/>

                        <CheckBox x:Name="ChkRegistrySnapshot" Style="{StaticResource ModernCheckBox}" Content="Capture Pre-Tweak Registry Snapshot to Local Storage" IsChecked="True" FontWeight="Bold"/>
                        <TextBlock Text="Captures exact original values of all targeted registry keys into %LOCALAPPDATA%\NHWinDebloater\Backups\." FontSize="12" Foreground="#94A3B8" Margin="24,0,0,10"/>
                    </StackPanel>
                </Border>

                <!-- Dry-Run Preview Box -->
                <Border Grid.Row="2" Background="#0A0E17" CornerRadius="8" BorderBrush="#2A384F" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnRunDryRun" Style="{StaticResource ModernBtn}" Content="▶ Run Dry-Run Preview (WhatIf)" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtDryRunStatus" Text="Click to simulate changes without applying anything." VerticalAlignment="Center" FontSize="12" Foreground="#38BDF8"/>
                        </StackPanel>
                        <TextBox x:Name="TxtDryRunLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#0A0E17" Foreground="#E2E8F0" FontFamily="Consolas, Lucida Console" FontSize="12" BorderThickness="0" Padding="8"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- STAGE 4: Execution & Real-Time Progress -->
            <Grid x:Name="ViewStage4" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Applying Optimizations &amp; Debloating" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock x:Name="TxtProgressStatus" Text="Processing queue..." FontSize="13" Foreground="#38BDF8"/>
                </StackPanel>

                <ProgressBar x:Name="ProgExecution" Grid.Row="1" Height="8" Background="#1E293B" Foreground="#0EA5E9" Margin="0,0,0,16"/>

                <Border Grid.Row="2" Background="#0A0E17" CornerRadius="8" BorderBrush="#2A384F" BorderThickness="1" Padding="14">
                    <TextBox x:Name="TxtLiveLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#0A0E17" Foreground="#E2E8F0" FontFamily="Consolas, Lucida Console" FontSize="12" BorderThickness="0"/>
                </Border>
            </Grid>

            <!-- STAGE 5: Summary & Post-Optimization -->
            <Grid x:Name="ViewStage5" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <TextBlock Text="Optimization Complete!" FontSize="20" FontWeight="Bold" Foreground="#10B981"/>
                    <TextBlock Text="All selected debloating steps, registry policies, and performance enhancements have been executed." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Metrics Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#131D31" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Total Tasks Processed" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtStatTotal" Text="0" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#131D31" CornerRadius="8" Padding="16" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="Successfully Applied" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtStatSuccess" Text="0" FontSize="26" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#131D31" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Skipped / Safeguarded" FontSize="12" Foreground="#94A3B8"/>
                                <TextBlock x:Name="TxtStatSkipped" Text="0" FontSize="26" FontWeight="Bold" Foreground="#38BDF8"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="#131D31" CornerRadius="8" BorderBrush="#2A384F" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Recommended Next Steps:" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,10"/>
                            <TextBlock Text="• Restart Windows Explorer to immediately refresh Taskbar and desktop icons." FontSize="13" Foreground="#CBD5E1" Margin="0,2"/>
                            <TextBlock Text="• For complete policy enforcement (Fast Startup / Driver exclusions), a system reboot is recommended." FontSize="13" Foreground="#CBD5E1" Margin="0,2"/>
                            <TextBlock Text="• Review session execution log file or backup snapshots at any time." FontSize="13" Foreground="#CBD5E1" Margin="0,2"/>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button x:Name="BtnRestartExplorer" Style="{StaticResource ModernBtn}" Content="⟳ Restart Windows Explorer" Margin="0,0,10,0"/>
                                <Button x:Name="BtnOpenLog" Style="{StaticResource ModernBtn}" Content="📄 View Execution Log" Margin="0,0,10,0"/>
                                <Button x:Name="BtnOpenBackups" Style="{StaticResource ModernBtn}" Content="📁 Open Backups Folder"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 4. Footer Bar & Navigation -->
        <Border Grid.Row="3" Background="#131D31" BorderBrush="#2A384F" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Promotion Block -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NH Win Debloater is maintained by " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center">
                        <Hyperlink x:Name="LinkNhDigital" NavigateUri="https://nhdigital.shop" Foreground="#38BDF8" TextDecorations="None">
                            <TextBlock Text="NH Digital" FontWeight="SemiBold"/>
                        </Hyperlink>
                    </TextBlock>
                    <TextBlock Text=" | Discover more tools at " FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <TextBlock VerticalAlignment="Center">
                        <Hyperlink NavigateUri="https://nhdigital.shop" Foreground="#0EA5E9" TextDecorations="None">
                            <TextBlock Text="nhdigital.shop"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- Wizard Navigation Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Style="{StaticResource ModernBtn}" Content="Back" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <Button x:Name="BtnNext" Style="{StaticResource PrimaryBtn}" Content="Next ›" Margin="0,0,10,0"/>
                    <Button x:Name="BtnApply" Style="{StaticResource PrimaryBtn}" Content="Apply Optimizations" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <Button x:Name="BtnFinish" Style="{StaticResource PrimaryBtn}" Content="Finish &amp; Exit" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
