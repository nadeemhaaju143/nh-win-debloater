                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ChkTelemetry" Grid.Column="0" Style="{StaticResource ModernCheckBox}" Content="Disable Telemetry &amp; Diagnostic Data Collection (Security/Basic level)" IsChecked="True"/>
                                        <Border Grid.Column="1" Background="#064E3B" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconCheckCircle}" Fill="#34D399" Width="10" Height="10" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="RECOMMENDED" FontSize="9" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>
